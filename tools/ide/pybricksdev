#!/bin/sh
# CHANGE (Nov 13): THE SAME AS pybricksdev.cmd, FOR A MAC (AND GIT BASH ON WINDOWS)
# The "Run on LEGO Brick" button types this in VS Code's "Pybricks" terminal:
#     pybricksdev run ble --name "PixieBricks" "/Users/.../DR26-27/main.py"
# .vscode/settings.json puts this folder first in the terminal's PATH, so
# "pybricksdev" starts this file instead of the real one. It hands the whole
# command to tools/run_logged.py. That runs the real pybricksdev, saves the
# output in the logs folder, and uploads it to GitHub.
# If no Python works, the real pybricksdev runs with no log, so the robot
# still runs.

here=$(cd "$(dirname "$0")" && pwd -P)

# The first Python 3.9 or newer that works. On Windows, "python3" can be a
# stand-in that only opens the Microsoft Store, so each one is tried first.
for python in python3 python py; do
    if "$python" -c "import sys; sys.exit(sys.version_info < (3, 9))" >/dev/null 2>&1; then
        exec "$python" "$here/../run_logged.py" "$@"
    fi
done

# No Python works: run the real pybricksdev from PATH, skipping this folder.
set -f
IFS=:
for folder in $PATH; do
    [ -n "$folder" ] || continue
    [ "$(cd "$folder" 2>/dev/null && pwd -P)" = "$here" ] && continue
    if [ -f "$folder/pybricksdev" ] && [ -x "$folder/pybricksdev" ]; then
        echo "No Python found, so no log is saved this time." >&2
        exec "$folder/pybricksdev" "$@"
    fi
done
echo "pybricksdev is not installed. Install it with: pip install pybricksdev" >&2
exit 1
